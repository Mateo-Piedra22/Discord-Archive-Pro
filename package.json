{
  "name": "estrato",
  "version": "2.5.0",
  "description": "Estrato — Archivo vivo de comunidades de Discord en disco local (Markdown, HTML, JSON, CSV, PDF y EPUB)",
  "main": "./out/main/index.js",
  "author": "Estrato",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "icon": "node scripts/generate-icon.js",
    "package": "npm run build && electron-builder --win portable",
    "package:installer": "npm run build && electron-builder --win nsis --publish never",
    "verify:release": "node scripts/verify-release.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "better-sqlite3": "^11.7.0",
    "epub-gen-memory": "^1.1.2",
    "epubjs": "^0.3.93",
    "lucide-react": "^1.8.0",
    "pdf-lib": "^1.17.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sanitize-filename": "^1.6.4",
    "sharp": "^0.34.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^34.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.estrato.app",
    "productName": "Estrato",
    "copyright": "Copyright © 2026 Estrato",
    "asar": true,
    "win": {
      "target": "portable",
      "icon": "resources/icon.ico"
    },
    "portable": {
      "artifactName": "Estrato.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Estrato-Setup-${version}.exe",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "shortcutName": "Estrato"
    },
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "!out/**/*.tsbuildinfo",
      "resources/icon.png",
      "resources/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/fonts",
        "to": "fonts"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ]
  }
}
