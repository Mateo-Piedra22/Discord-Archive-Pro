{
  "name": "foro-downloader",
  "version": "1.0.0",
  "description": "Discord Forum Downloader - Download complete forum posts as formatted Markdown",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "package": "electron-builder --win portable",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/dompurify": "^3.0.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "better-sqlite3": "^11.7.0",
    "canvas-confetti": "^1.9.4",
    "dompurify": "^3.4.0",
    "epub-gen-memory": "^1.1.2",
    "epubjs": "^0.3.93",
    "framer-motion": "^12.38.0",
    "i18next": "^26.0.6",
    "lucide-react": "^1.8.0",
    "mime-types": "^3.0.2",
    "node-cron": "^4.2.1",
    "node-notifier": "^10.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "react-json-view": "^1.21.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sanitize-filename": "^1.6.4",
    "sharp": "^0.34.5",
    "turndown": "^7.2.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.forodownloader.app",
    "productName": "ForoDownloader",
    "win": {
      "target": "portable",
      "icon": "resources/icon.ico"
    },
    "portable": {
      "artifactName": "ForoDownloader.exe"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/"
      }
    ]
  }
}
